<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="640.0" prefWidth="980.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectolaboratorio.controller.LaboratorioController">
    <children>
        <Label text="Control de equipos de laboratorio">
            <font><Font name="Times New Roman Bold" size="22.0" /></font>
        </Label>
        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="80.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="80.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Código:" />
                <TextField fx:id="txtCodigo" promptText="Código del equipo" GridPane.columnIndex="1" />
                <Label text="Nombre:" GridPane.columnIndex="2" />
                <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.columnIndex="3" />
                <Label text="Marca:" GridPane.rowIndex="1" />
                <TextField fx:id="txtMarca" promptText="Marca" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Cantidad:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtCantidad" promptText="Cantidad" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <Label text="Tipo:" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbTipo" prefWidth="250.0" promptText="Seleccione tipo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbEstado" prefWidth="250.0" promptText="Seleccione estado" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" onAction="#guardarEquipo" text="Guardar" />
                <Button fx:id="btnActualizar" onAction="#actualizarEquipo" text="Actualizar" />
                <Button fx:id="btnEliminar" onAction="#eliminarEquipo" text="Eliminar" />
                <Button onAction="#limpiarCampos" text="Limpiar" />
                <Button onAction="#demostrarRollback" text="Probar rollback" />
            </children>
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Buscar nombre:" />
                <TextField fx:id="txtBuscar" promptText="Parte del nombre" />
                <Label text="Tipo:" />
                <ComboBox fx:id="cmbFiltroTipo" prefWidth="180.0" />
                <Button onAction="#aplicarFiltros" text="Buscar / Aplicar filtros" />
            </children>
        </HBox>
        <TableView fx:id="tblEquipos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="230.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="130.0" text="Marca" />
                <TableColumn fx:id="colEstado" prefWidth="160.0" text="Estado" />
                <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay equipos para mostrar." />
            </placeholder>
        </TableView>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>
